{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "WebSearch",
      "WebFetch",
      "Write(.commit_msg.txt)",
      "Edit(.commit_msg.txt)",
      "PowerShell(git status)",
      "PowerShell(git status --short)",
      "PowerShell(git log)",
      "PowerShell(git diff)",
      "PowerShell(git branch)",
      "PowerShell(git add -A)",
      "PowerShell(git commit -F .commit_msg.txt)",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git log)",
      "Bash(git diff)",
      "Bash(git branch)",
      "Bash(git add -A)",
      "Bash(git commit -F .commit_msg.txt)",
      "PowerShell(flutter test)",
      "PowerShell(flutter test --reporter failures-only)",
      "PowerShell(flutter analyze)",
      "PowerShell(flutter doctor)",
      "PowerShell(flutter devices)",
      "PowerShell(flutter pub get)",
      "PowerShell(flutter clean)",
      "PowerShell(flutter build apk)",
      "PowerShell(flutter build apk --release --split-per-abi)",
      "PowerShell(dart analyze)",
      "PowerShell(.venv\\Scripts\\python.exe -m pytest)",
      "PowerShell(.venv\\Scripts\\python.exe -m pytest -q)",
      "PowerShell(.venv\\Scripts\\python.exe scripts/measure_approvals.py)",
      "PowerShell(.venv\\Scripts\\python.exe scripts/measure_wait.py)",
      "PowerShell(C:\\Users\\user\\AppData\\Local\\Android\\Sdk\\platform-tools\\adb.exe devices)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_redundant_cd.py\"",
            "timeout": 10,
            "statusMessage": "cd 접두사 검사"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_output_filter.py\"",
            "timeout": 10,
            "statusMessage": "출력 필터 검사"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_targeted_flutter_test.py\"",
            "timeout": 10,
            "statusMessage": "flutter test 인자 검사"
          }
        ]
      }
    ]
  }
}
