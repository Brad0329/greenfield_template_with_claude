{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "WebSearch",
      "WebFetch",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(curl.exe *)",
      "PowerShell(Expand-Archive *)",
      "PowerShell(tar *)",
      "PowerShell(py *)",
      "PowerShell(.venv\\Scripts\\python.exe *)",
      "PowerShell(flutter analyze)",
      "PowerShell(flutter analyze *)",
      "PowerShell(flutter test)",
      "PowerShell(flutter test *)",
      "PowerShell(dart format *)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git add *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git log)",
      "PowerShell(git log *)",
      "PowerShell(git commit -F .git/COMMIT_MSG_CLAUDE.txt)",
      "Write(.git/COMMIT_MSG_CLAUDE.txt)",
      "Edit(.git/COMMIT_MSG_CLAUDE.txt)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)"
    ]
  }
}
