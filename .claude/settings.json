{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_redundant_cd.py\"",
            "timeout": 10,
            "statusMessage": "cd 접두사 검사"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_output_filter.py\"",
            "timeout": 10,
            "statusMessage": "출력 필터 검사"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_targeted_flutter_test.py\"",
            "timeout": 10,
            "statusMessage": "flutter test 인자 검사"
          }
        ]
      }
    ]
  }
}
